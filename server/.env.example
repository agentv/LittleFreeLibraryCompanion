# Copy to docker/.env on the server and fill in. Never commit the real file.

# Public address of the API (behind the host's existing web server, with HTTPS).
PUBLIC_URL=https://api.example.org

# Postgres passwords (long random strings).
POSTGRES_PASSWORD=
API_DB_PASSWORD=
AUTH_DB_PASSWORD=

# Shared by Supabase Auth and the Node service; at least 32 random characters.
JWT_SECRET=

# Email sender for sign-in codes and sign-up confirmations (for example Amazon SES SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=LFL Steward Companion

# Media bucket (private). The server's IAM role needs s3:PutObject, s3:GetObject
# and s3:HeadObject (via GetObject) on it; no access keys are needed on EC2.
S3_BUCKET=
AWS_REGION=us-west-2

# Nice-to-have, off by default (backend R22).
FEATURE_ADDRESS_SUGGESTIONS=off
